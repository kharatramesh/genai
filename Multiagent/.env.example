# --- Offline models (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Online models (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Set to 1 to run the "online" agents on the local Ollama model too (no API key needed)
FORCE_OFFLINE=0

# --- Langfuse (cloud.langfuse.com, or your self-hosted URL) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Human in the loop ---
# 1 = skip approval prompts (only for automated tests!)
AUTO_APPROVE=0
APPROVE_PLAN=0
